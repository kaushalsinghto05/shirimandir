{
  "name": "shirimandir",
  "private": true,
  "version": "1.0.0",
  "description": "Shiri Mandir - Temple Puja, Prasad & Seva Booking Platform with Built-in Legal and Ethical Compliance",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "node --watch backend/server.js",
    "dev:frontend": "vite",
    "seed:backend": "node backend/src/database/seed.js",
    "test:backend": "node --test backend/tests/compliance.test.js",
    "build": "vite build",
    "build:render": "npm install && npm run build && cd backend && npm install",
    "start": "node backend/server.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0"
  }
}
