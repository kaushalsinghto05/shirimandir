{
  "name": "shirimandir",
  "private": true,
  "version": "1.0.0",
  "description": "Shiri Mandir - Temple Puja, Prasad & Seva Booking Platform with Built-in Legal and Ethical Compliance",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "node --watch backend/server.js",
    "dev:frontend": "vite",
    "seed:backend": "node backend/src/database/seed.js",
    "test:backend": "node --test backend/tests/compliance.test.js",
    "test:tenant-suite": "tsx --test tests/isolation/tenant_isolation.test.ts",
    "test:acceptance": "tsx --test tests/acceptance/acceptance_matrix.test.ts",
    "test:expansion": "tsx --test tests/expansion/p1_expansion.test.ts",
    "test:all-suites": "tsx --test tests/isolation/tenant_isolation.test.ts tests/acceptance/acceptance_matrix.test.ts tests/expansion/p1_expansion.test.ts",
    "build": "vite build",
    "build:render": "npm install --include=dev && npm run build && npm --prefix backend install",
    "start": "node backend/server.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.475.0",
    "next": "^14.2.15",
    "otpauth": "^9.5.2",
    "pg": "^8.23.1",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vite": "^6.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0"
  }
}
