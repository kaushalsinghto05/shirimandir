# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# JWT Authentication
JWT_SECRET=shirimandir_sacred_jwt_secret_key_2026
JWT_EXPIRES_IN=7d

# Payment Gateway (Razorpay / PayU) Webhook Security
# Used for HMAC SHA-256 signature verification. NEVER share publicly.
PAYMENT_WEBHOOK_SECRET=rzp_test_webhook_secret_key_9921

# Database Configuration
# Leave empty for zero-setup local SQLite DB (Node 24 built-in DatabaseSync).
# Provide PostgreSQL URL for production on Railway, Render, Supabase, or AWS RDS:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/shirimandir

# Media Storage Configuration
STORAGE_PROVIDER=local
# For AWS S3 / Cloudflare R2 / MinIO in production:
# STORAGE_PROVIDER=s3
# S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
# S3_BUCKET=shirimandir-proofs
# S3_ACCESS_KEY=your_access_key
# S3_SECRET_KEY=your_secret_key
# PUBLIC_STORAGE_URL=https://shirimandir-proofs.s3.ap-south-1.amazonaws.com
